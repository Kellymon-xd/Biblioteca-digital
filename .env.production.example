# ============================================================
# BIBLIOTECA DIGITAL - PRODUCCIÓN / DOMINIO PÚBLICO
# Copia este archivo como .env en el servidor y cambia los secretos.
# ============================================================
APP_NAME="Biblioteca Digital"
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Panama
APP_URL=https://biblioteca.tudominio.com
APP_PORT=8080

DB_HOST=db
DB_PORT=3306
DB_NAME=biblioteca_digital
DB_USER=bib_app
DB_PASS="CAMBIA_ESTA_CLAVE_DB_LARGA"
DB_ROOT_PASSWORD="CAMBIA_ESTA_CLAVE_ROOT_LARGA"
DB_CHARSET=utf8mb4

APP_SECRET="CAMBIA_ESTA_CLAVE_APP_SECRET_DE_MINIMO_32_CARACTERES"
MAX_LOGIN_INTENTOS=3
POR_PAGINA=10
API_ENABLED=false
SECURE_HEADERS=true
CSP_ENABLED=true
SESSION_SECURE=true
SESSION_NAME=BIBLIOTECA_SESION

DIAS_PRESTAMO_ESTUDIANTE=3
DIAS_PRESTAMO_PROFESOR=3
